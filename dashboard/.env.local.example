# Dashboard env vars — copiar a .env.local y rellenar. NUNCA commitear .env.local.

# ── Supabase (PostgREST, dashboard normal) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# service_role (bypassa RLS) — solo server-side (lib/supabase/admin.ts)
SUPABASE_SECRET_KEY=

# ── NextAuth (Google + allowlist) ────────────────────────────────────────────
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Allowlist de emails (coma-separados) que pueden entrar. FUENTE UNICA: gatea TANTO
# el login del dashboard COMO el conector MCP el-cerebro (AIR-157b) — el conector
# exige que el claim `email` del token de Descope este en esta lista. Vacia ⇒ nadie
# pasa (fail-closed). Ej: ALLOWED_EMAILS=owner@airedeagua.com,otro@airedeagua.com
ALLOWED_EMAILS=

# ── Conector MCP el-cerebro (AIR-157) ────────────────────────────────────────
# Connection string Postgres del rol LOGIN `el_cerebro_login` (migracion 087).
# El password lo setea el owner fuera de banda (ALTER ROLE ... PASSWORD '...').
# Formato: postgresql://el_cerebro_login:<PASSWORD>@<HOST>:5432/postgres
# NUNCA commitear el valor real con password.
CEREBRO_READER_DATABASE_URL=
# Opcional: 'disable' para apagar SSL en local (en prod dejar vacio → SSL on).
# En prod la conexion valida el certificado del servidor (rejectUnauthorized: true).
CEREBRO_READER_SSL=
# OPCIONAL: CA pem para anclar el certificado del servidor Postgres. Supabase usa
# CAs publicas validas, asi que normalmente NO hace falta. Setear solo si se quiere
# pinning explicito de CA (pegar el contenido del .pem en una sola variable).
SUPABASE_DB_CA_CERT=

# ── OAuth del conector MCP — Authorization Server = Descope (DCR) ─────────────
# Descope es el AS: hace DCR, PKCE, authorize y token. Nuestro servidor solo
# anuncia a Descope (/.well-known/oauth-protected-resource) y verifica el JWT
# (lib/mcp/auth.ts + lib/mcp/oauth-provider.ts). Ver docs/cerebro/I7-conector-mcp.md.
#
# REQUERIDO: Project ID de Descope (consola Descope → Project Settings).
DESCOPE_PROJECT_ID=
# REQUERIDO PARA DCR — id del MCP Server "agentic" en Descope (consola Descope →
# MCP Servers, p.ej. RS3FVPGYHTgNlDGQ6Z2xBJ66iri31). Deriva el Authorization
# Server que SE ANUNCIA para DCR/descubrimiento (el unico que expone
# registration_endpoint):
#   authServerUrl = https://api.descope.com/v1/apps/agentic/<PROJECT_ID>/<MCP_SERVER_ID>
# Sin el, Claude.ai falla con "Automatic client registration isn't supported".
# NO cambia el issuer/jwksUri del token (siguen en forma de proyecto).
DESCOPE_MCP_SERVER_ID=
# OPCIONAL — override de la URL completa del AS agentic (si DESCOPE_MCP_SERVER_ID
# no basta para derivarla). Tiene prioridad sobre la derivacion.
# DESCOPE_AUTH_SERVER_URL=
# OPCIONAL — solo si usas dominio/issuer custom de Descope. Por defecto se derivan:
#   issuer  = https://api.descope.com/v1/apps/<DESCOPE_PROJECT_ID>
#   jwksUri = https://api.descope.com/<DESCOPE_PROJECT_ID>/.well-known/jwks.json
# DESCOPE_ISSUER=
# DESCOPE_JWKS_URI=
# REQUERIDO — audience esperado en el token (= resource identifier del MCP server).
# DEBE coincidir con el Audience configurado en el Inbound App de Descope. jwtVerify
# valida SIEMPRE el claim `aud` contra este valor (defensa contra token confusion).
DESCOPE_AUDIENCE=https://dashboard.airedeagua.com/api/mcp
