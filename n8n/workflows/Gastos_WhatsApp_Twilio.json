      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const wh = ($('WA Webhook Twilio').first().json.body) || {};\nlet usuario = {};\ntry { usuario = $('Allowlist Usuario').first().json || {}; } catch (e) {}\nlet sesion = {};\ntry { sesion = $('Leer Sesion').first().json || {}; } catch (e) {}\nconst sanitize = (s) => String(s || '').replace(/[\\x00-\\x1F\\x7F]/g, ' ').replace(/<[^>]*>/g, '').slice(0, 1000);\nconst hoy = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Bogota' });\nconst bodySan = sanitize(wh.Body);\nconst numMedia = parseInt(wh.NumMedia || '0', 10) || 0;\nconst esPendiente = sesion.estado === 'pendiente_confirmacion' && !!sesion.expira_at && new Date(sesion.expira_at).getTime() > Date.now();\nconst tieneMedia = numMedia > 0;\nconst esComando = /^(resumen|anular)\\b/i.test(bodySan.trim());\nlet ruta = 'gasto';\nif (esPendiente) { ruta = 'pendiente'; } else if (tieneMedia) { ruta = 'media'; } else if (esComando) { ruta = 'comando'; }\nreturn [{ json: {\n  telefono: String(wh.From || ''),\n  message_sid: String(wh.MessageSid || ''),\n  body_san: bodySan,\n  hoy: hoy,\n  usuario_email: String(usuario.email || ''),\n  usuario_nombre: String(usuario.nombre || ''),\n  pagador_default: String(usuario.pagador_default || 'aire_de_agua'),\n  ruta: ruta,\n  esPendiente: esPendiente,\n  tieneMedia: tieneMedia,\n  esComando: esComando\n} }];"
