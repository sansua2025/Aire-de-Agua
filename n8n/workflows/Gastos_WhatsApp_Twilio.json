    {
      "name": "Parse y Valida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ctx = $('Contexto Sanitizado').first().json;\nconst catRows = $('Catalogo Categorias').all().map((i) => i.json);\nconst resp = $input.first().json || {};\nlet text = '';\nif (Array.isArray(resp.content)) { text = resp.content.filter((c) => c.type === 'text').map((c) => c.text).join(' '); }\nconst sanitize = (s, n) => String(s || '').replace(/[\\x00-\\x1F\\x7F]/g, ' ').replace(/<[^>]*>/g, '').slice(0, n || 300);\nlet parsed = null;\ntry { parsed = JSON.parse(text); } catch (e) {}\nif (!parsed) {\n  const start = text.indexOf('{');\n  if (start >= 0) {\n    let depth = 0;\n    for (let k = start; k < text.length; k++) {\n      if (text[k] === '{') { depth++; }\n      if (text[k] === '}') { depth--; if (depth === 0) { try { parsed = JSON.parse(text.slice(start, k + 1)); } catch (e2) {} break; } }\n    }\n  }\n}\nconst base = { message_sid: ctx.message_sid, telefono: ctx.telefono, gasto_id: null };\nif (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n  return [{ json: Object.assign(base, { ok: false, guardar: false, accion: 'parse_error', reply_text: \"No te entendí 😅 Prueba algo como: 'Almuerzo feria 85 mil'\" }) }];\n}\nconst catIds = catRows.map((c) => c.id);\nconst gasto = {};\ngasto.concepto = sanitize(parsed.concepto, 200).trim();\ngasto.monto = Number(parsed.monto);\ngasto.fecha = /^\\d{4}-\\d{2}-\\d{2}$/.test(String(parsed.fecha || '')) ? String(parsed.fecha) : ctx.hoy;\ngasto.categoria_id = catIds.indexOf(String(parsed.categoria_id)) >= 0 ? String(parsed.categoria_id) : null;\ngasto.pagador_id = ['aire_de_agua', 'santi_susi'].indexOf(String(parsed.pagador_id)) >= 0 ? String(parsed.pagador_id) : (ctx.pagador_default || 'aire_de_agua');\nlet confianza = Number(parsed.confianza);\nif (!isFinite(confianza) || confianza < 0 || confianza > 1) { confianza = 0; }\nconst ambiguos = Array.isArray(parsed.campos_ambiguos) ? parsed.campos_ambiguos.slice(0, 10).map((x) => sanitize(x, 50)) : [];\nlet pregunta = parsed.pregunta ? sanitize(parsed.pregunta, 300) : null;\nconst montoOk = isFinite(gasto.monto) && gasto.monto > 0;\nconst conceptoOk = gasto.concepto.length > 0;\nconst categoriaOk = gasto.categoria_id !== null;\nconst guardar = confianza >= 0.8 && ambiguos.length === 0 && montoOk && conceptoOk && categoriaOk;\nif (!guardar && !pregunta) {\n  const faltan = [];\n  if (!montoOk) { faltan.push('el monto'); }\n  if (!conceptoOk) { faltan.push('qué fue el gasto'); }\n  if (!categoriaOk) { faltan.push('la categoría'); }\n  pregunta = faltan.length ? ('¿Me confirmas ' + faltan.join(' y ') + '? 🙏') : '¿Me lo confirmas con un poco más de detalle? 🙏';\n}\nconst catNombre = (catRows.filter((c) => c.id === gasto.categoria_id)[0] || {}).nombre || gasto.categoria_id;\nreturn [{ json: Object.assign(base, { ok: true, guardar: guardar, gasto: gasto, confianza: confianza, campos_ambiguos: ambiguos, pregunta: pregunta, categoria_nombre: catNombre }) }];"
      }
    },
