        "jsCode": "const c = $input.first().json;\nconst sanitize = (str) => str ? str.replace(/[\\x00-\\x1F]/g, \"\").substring(0, 5000) : null;\n\nc.first_name = sanitize(c.first_name);\nc.last_name = sanitize(c.last_name);\nc.email = sanitize(c.email);\nc.phone = sanitize(c.phone);\n\nif (c.default_address) {\n  c.default_address.city = sanitize(c.default_address.city);\n  c.default_address.province = sanitize(c.default_address.province);\n}\n\nreturn [{ json: c }];"
      },
