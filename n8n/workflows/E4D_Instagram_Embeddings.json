              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal,resolution=merge-duplicates"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ meta_post_id: $json.meta_post_id, plataforma: $json.plataforma, tipo: $json.tipo, texto_fuente: $json.texto_fuente, embedding: $json.embedding, modelo: $json.modelo }) }}",
        "options": {}
