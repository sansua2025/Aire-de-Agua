    {
      "parameters": {
        "jsCode": "// Calculo 100% numerico de observado vs referencia. Sin LLM, sin texto libre.\nconst row = $('Split Rows').item.json;\nconst metricRows = $('Fetch Metric (by canal)').all().map(i => i.json).filter(Boolean);\nconst canal = row.canal;\n\nfunction num(v) { const n = Number(v); return Number.isFinite(n) ? n : null; }\n\nlet metrica;\nlet observado = null;\nlet referencia = null;\n\nif (canal === 'email') {\n  // metrica = ingresos del envio mas reciente; referencia = promedio de ingresos de los envios recientes (>0).\n  metrica = 'ingresos';\n  const vals = metricRows.map(r => num(r.ingresos)).filter(v => v != null && v > 0);\n  observado = vals.length ? vals[0] : null;\n  const prev = vals.slice(1);\n  referencia = prev.length ? (prev.reduce((a, b) => a + b, 0) / prev.length) : (vals.length ? vals[0] : null);\n} else {\n  // meta_ads / organico tratados como paid: metrica = roas_real ATRIBUIDO (revenue REAL / gasto).\n  // SIN PRORRATEO. La verdad vive en v_meta_ads_roas_real_asset (mig 076), grain ad_name/creativo:\n  // revenue real (Shopify, NO pixel) atribuido por utm_content (slug) -> ad_name via el mapping\n  // curado creative_utm_map; el asset se resuelve por creative_asset_ids (array) de la vista.\n  // PROHIBIDO el revenue del pixel de Meta y la col GENERATED 'roas'.\n  // CAVEAT: solo creativos mapeados (tiene_atribucion_real=true, ya filtrado en el fetch) tienen\n  // revenue real. Si el creativo analizado NO esta mapeado, no hay filas -> observado=null -> skip\n  // (NO se reporta ROAS=0, que falsearia el learning).\n  metrica = 'roas_real';\n  const assetRows = $('Fetch ROAS Real (asset)').all().map(i => i.json).filter(Boolean)\n    .filter(r => r && r.tiene_atribucion_real === true);\n  // observado = ROAS real del creativo = SUM(revenue real atribuido) / SUM(gasto real).\n  // Si el asset mapea a >1 ad_name, se suman revenues y gastos reales (sigue siendo real, no prorrateo).\n  let revAsset = 0;\n  let gastoAsset = 0;\n  for (const a of assetRows) {\n    const rev = num(a.revenue_real_cop);\n    const g = num(a.gasto_cop);\n    if (rev == null || g == null || g <= 0) continue;\n    revAsset += rev;\n    gastoAsset += g;\n  }\n  observado = gastoAsset > 0 ? (revAsset / gastoAsset) : null;\n  // referencia = ROAS real promedio (ponderado por gasto) de TODOS los creativos con atribucion\n  // real en la vista; baseline 1.0 (ROAS de equilibrio) si aun no hay historia. Numerico, sin pixel.\n  const benchRows = $('Fetch ROAS Bench (asset)').all().map(i => i.json).filter(Boolean)\n    .filter(r => r && r.tiene_atribucion_real === true);\n  let revRef = 0, gastoRef = 0;\n  for (const b of benchRows) {\n    const g = num(b.gasto_cop);\n    const rev = num(b.revenue_real_cop);\n    if (g == null || g <= 0 || rev == null) continue;\n    revRef += rev; gastoRef += g;\n  }\n  referencia = gastoRef > 0 ? (revRef / gastoRef) : 1.0;\n}\n\nconst valido = observado != null && referencia != null && referencia !== 0;\n\nreturn [{ json: {\n  calendario_id: row.id,\n  creative_asset_id: row.creative_asset_id,\n  canal: canal,\n  metrica: metrica,\n  valor_observado: observado,\n  valor_referencia: referencia,\n  valido: valido\n} }];"
      },
