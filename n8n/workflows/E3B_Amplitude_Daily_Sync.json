    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const yesterday = $(\"Set Config\").first().json.yesterdayISO;\nfunction getVal(nodeName) {\n  try {\n    const data = $(nodeName).first().json;\n    if (data && data.data && data.data.series && data.data.series[0]) {\n      return data.data.series[0][0] || 0;\n    }\n    return 0;\n  } catch (e) { return 0; }\n}\nconst sesiones = getVal(\"Get Sessions\");\nconst usuarios_activos = getVal(\"Get Active Users\");\nconst usuarios_nuevos = getVal(\"Get New Users\");\nconst pageviews = getVal(\"Get Pageviews\");\nconst vistas_producto = getVal(\"Get Product Views\");\nconst agrega_carrito = getVal(\"Get Add to Cart\");\nconst inicia_checkout = getVal(\"Get Checkout\");\nconst compras = getVal(\"Get Orders\");\nconst paginas_por_sesion = sesiones > 0 ? parseFloat((pageviews / sesiones).toFixed(2)) : 0;\nreturn [{ json: { metrics_data: { fecha: yesterday, sesiones, usuarios_activos, usuarios_nuevos, pageviews, vistas_producto, agrega_carrito, inicia_checkout, compras, duracion_sesion_avg: null, paginas_por_sesion, tasa_rebote: null } } }];"
      },
