    {
      "parameters": {
        "jsCode": "const ws = $(\"Set Config\").first().json.weekStart;\nconst vd = $(\"Get Top Products\").first().json;\nconst ud = $(\"Get Top Uniques\").first().json;\nconst lb = (vd && vd.data && vd.data.seriesLabels) || [];\nconst vs = (vd && vd.data && vd.data.seriesCollapsed) || [];\nconst us = (ud && ud.data && ud.data.seriesCollapsed) || [];\n\nfunction num(v) {\n  if (v == null) return 0;\n  if (typeof v === 'object') return Number(v.value) || 0;\n  return Number(v) || 0;\n}\nfunction lbl(v) {\n  if (Array.isArray(v)) return String(v[v.length - 1]);\n  return String(v == null ? '' : v);\n}\n\nconst content = [];\nfor (let i = 0; i < lb.length; i++) {\n  const vistas = num(vs[i] && vs[i][0]);\n  if (vistas <= 0) continue;\n  const name = lbl(lb[i]);\n  content.push({\n    semana_inicio: ws,\n    tipo: \"producto\",\n    entidad_id: name,\n    nombre: name,\n    vistas: vistas,\n    usuarios_unicos: num(us[i] && us[i][0]),\n    tasa_conversion: null,\n    posicion_ranking: i + 1\n  });\n}\nreturn [{ json: { content_data: content } }];\n"
      },
