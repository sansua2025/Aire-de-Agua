    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ws = $(\"Set Config\").first().json.weekStart;\nconst vd = $(\"Get Top Products\").first().json;\nconst ud = $(\"Get Top Uniques\").first().json;\nconst lb = (vd && vd.data && vd.data.seriesLabels) || [];\nconst vs = (vd && vd.data && vd.data.seriesCollapsed) || [];\nconst us = (ud && ud.data && ud.data.seriesCollapsed) || [];\nfunction num(v) { if (v == null) return 0; if (typeof v === 'object') return Number(v.value) || 0; return Number(v) || 0; }\nfunction lbl(v) { if (Array.isArray(v)) return String(v[v.length - 1]); return String(v == null ? '' : v); }\nconst content = [];\nfor (let i = 0; i < lb.length; i++) {\n  const vistas = num(vs[i] && vs[i][0]);\n  if (vistas <= 0) continue;\n  const name = lbl(lb[i]);\n  content.push({ semana_inicio: ws, tipo: \"producto\", entidad_id: name, nombre: name, vistas: vistas, usuarios_unicos: num(us[i] && us[i][0]), tasa_conversion: null, posicion_ranking: i + 1 });\n}\nreturn [{ json: { content_data: content } }];"
      },
