      "id": "a1b2c3d4-1001-4aaa-b001-000000000015",
      "name": "Get Top Uniques",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [2096, 208],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
