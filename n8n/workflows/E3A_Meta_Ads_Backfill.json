    {
      "parameters": {
        "url": "=https://graph.facebook.com/{{ $(\"Set Config\").first().json.apiVersion }}/act_{{ $(\"Set Config\").first().json.adAccountId }}/insights",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "time_range",
              "value": "={{ JSON.stringify({ since: $json.fecha, until: $json.fecha }) }}"
            },
            {
              "name": "level",
              "value": "ad"
            },
            {
              "name": "fields",
              "value": "ad_id,ad_name,adset_id,adset_name,campaign_id,campaign_name,objective,impressions,reach,clicks,inline_link_clicks,spend,actions,action_values"
            },
            {
              "name": "limit",
              "value": "500"
            },
            {
              "name": "filtering",
              "value": "[{\"field\":\"impressions\",\"operator\":\"GREATER_THAN\",\"value\":\"0\"}]"
            }
          ]
        },
        "options": {}
      },
      "id": "ac148945-0dab-441e-a705-66940bff8262",
      "name": "Fetch Meta Ads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1120,
        464
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER",
          "name": "Meta Ads Token"
        },
        "httpQueryAuth": {
          "id": "PLACEHOLDER",
          "name": "Query Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const fecha = $('Loop Days').item.json.fecha;\nconst items = $input.all();\nconst ads = [];\nfor (const it of items) {\n  const data = (it.json && it.json.data) || [];\n  for (const ad of data) ads.push(ad);\n}\nif (ads.length === 0) {\n  return [{ json: { ads_data: [], count: 0 } }];\n}\nconst findAction = (arr, type) => {\n  const f = (arr || []).find(a => a.action_type === type);\n  return f ? parseInt(f.value) || 0 : 0;\n};\nconst findActionValue = (arr, type) => {\n  const f = (arr || []).find(a => a.action_type === type);\n  return f ? parseFloat(f.value) || 0 : 0;\n};\nconst mapped = ads.map(ad => ({\n  fecha: fecha,\n  ad_id: ad.ad_id,\n  ad_name: ad.ad_name,\n  adset_id: ad.adset_id,\n  adset_name: ad.adset_name,\n  campaign_id: ad.campaign_id,\n  campaign_name: ad.campaign_name,\n  creative_asset_id: null,\n  es_pagado: true,\n  objetivo: ad.objective || null,\n  audiencia: ad.adset_name || null,\n  impresiones: parseInt(ad.impressions) || 0,\n  alcance: parseInt(ad.reach) || 0,\n  clics: parseInt(ad.clicks) || 0,\n  clics_link: parseInt(ad.inline_link_clicks) || 0,\n  gasto: parseFloat(ad.spend) || 0,\n  compras: findAction(ad.actions, 'purchase'),\n  valor_compras: findActionValue(ad.action_values, 'purchase'),\n  agrega_carrito: findAction(ad.actions, 'add_to_cart'),\n  inicia_checkout: findAction(ad.actions, 'initiate_checkout'),\n  vistas_contenido: findAction(ad.actions, 'view_content'),\n  headline: null,\n  body_copy: null,\n  cta: null,\n  meta_raw_json: ad\n}));\nreturn [{ json: { ads_data: mapped, count: mapped.length } }];"
      },
      "id": "db304801-801d-4109-afd0-b7928683a4d4",
      "name": "Transform Ads Data",
      "type": "n8n-nodes-base.code",
