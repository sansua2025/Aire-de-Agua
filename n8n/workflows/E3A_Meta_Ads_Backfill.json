      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        448,
        464
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $input.first().json;\nconst startMs = new Date(cfg.since + 'T00:00:00Z').getTime();\nconst endMs = new Date(cfg.until + 'T00:00:00Z').getTime();\nconst dayMs = 24 * 60 * 60 * 1000;\nif (isNaN(startMs) || isNaN(endMs) || startMs > endMs) {\n  throw new Error('Rango invalido: since=' + cfg.since + ', until=' + cfg.until);\n}\nconst total = Math.floor((endMs - startMs) / dayMs) + 1;\nconst days = [];\nfor (let i = 0; i < total; i++) {\n  const d = new Date(startMs + i * dayMs).toISOString().slice(0, 10);\n  days.push({ fecha: d, day_index: i + 1, day_total: total });\n}\nreturn days.map(j => ({ json: j }));"
      },
      "id": "42889d23-ca1d-4b65-a576-f5fd04232046",
      "name": "Generate Days",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        464
      ]
    },
    {
