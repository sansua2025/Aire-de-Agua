{
  "name": "E9B Meta Ads Executor (on approve)",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "ErrorHandlerGlobal01",
    "availableInMCP": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "nodes": [
    {
      "id": "trg_manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 300],
      "parameters": {}
    },
    {
      "id": "get_aprobados",
      "name": "GET propuestas meta aprobadas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [240, 300],
      "parameters": {
        "method": "GET",
        "url": "https://vnctmzsgemefgbtjctlo.supabase.co/rest/v1/insights",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "id,dominio,titulo,accion_sugerida,insight_key,estado_accion,accion_tomada,vigente"
            },
            { "name": "dominio", "value": "eq.paid" },
            { "name": "insight_key", "value": "like.meta_action_*" },
            { "name": "estado_accion", "value": "eq.en_curso" },
            { "name": "accion_tomada", "value": "is.true" },
            { "name": "vigente", "value": "is.true" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "filter_agente",
      "name": "Filtra propuestas del agente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "jsCode": "// Solo propuestas creadas por el generador E9B (marker en accion_sugerida).\n// accion_sugerida = JSON con { agente:'meta_action_agent', adset_id, accion, pct, ... }.\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  let meta;\n  try { meta = JSON.parse(r.accion_sugerida); } catch (e) { meta = null; }\n  if (!meta || meta.agente !== 'meta_action_agent' || !meta.adset_id) continue;\n  out.push({ json: {\n    insight_id: r.id,\n    titulo: r.titulo,\n    adset_id: String(meta.adset_id),\n    adset_name: meta.adset_name || meta.adset_id,\n    accion: meta.accion,\n    pct: meta.pct,\n    impacto_presupuesto_semanal: meta.impacto_presupuesto_semanal != null ? meta.impacto_presupuesto_semanal : null\n  } });\n}\nreturn out;\n"
      }
    },
    {
      "id": "loop",
      "name": "Por propuesta",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 300],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "get_decision",
      "name": "GET decision existente?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [900, 200],
      "parameters": {
        "method": "GET",
        "url": "https://vnctmzsgemefgbtjctlo.supabase.co/rest/v1/decisiones",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "id" },
            { "name": "insight_id", "value": "=eq.{{ $json.insight_id }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "if_nueva",
      "name": "Sin decision aun?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1120, 200],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "cn1",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "equals" }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "get_baseline",
      "name": "GET roas_real baseline (adset)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1340, 120],
      "parameters": {
        "method": "GET",
        "url": "https://vnctmzsgemefgbtjctlo.supabase.co/rest/v1/v_meta_ads_roas_real",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "adset_id,roas_real" },
            {
              "name": "adset_id",
              "value": "=eq.{{ $('Por propuesta').item.json.adset_id }}"
            },
            { "name": "limit", "value": "1" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "build_decision",
      "name": "Build decisiones row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 120],
      "parameters": {
        "jsCode": "// Construye la fila de decisiones (LOCKED constraints AIR-67).\n// valor_baseline = roas_real del adset AHORA (inmutable). NUNCA escribir\n// la columna GENERATED delta_real_pct. fecha_medicion = hoy + 14 dias.\nconst prop = $('Por propuesta').item.json;\nconst baselineRows = $input.all().map(i => i.json);\nconst baseline = (baselineRows[0] && typeof baselineRows[0].roas_real === 'number')\n  ? baselineRows[0].roas_real\n  : 0;\n\nconst hoy = new Date();\nconst medicion = new Date(hoy.getTime() + 14 * 24 * 3600 * 1000);\nconst fecha_medicion = medicion.toISOString().slice(0, 10);\n\nconst accionTxt = prop.accion === 'pausar'\n  ? 'Pausar adset ' + prop.adset_name\n  : 'Bajar ' + prop.pct + '% presupuesto adset ' + prop.adset_name;\n\nconst row = {\n  insight_id: prop.insight_id,\n  descripcion_accion: accionTxt + ' (' + prop.adset_id + ')',\n  canal: 'meta',\n  ejecutado_por: 'agente_aprobado',\n  ejecutado_at: hoy.toISOString(),\n  metrica_objetivo: 'roas_real',\n  valor_baseline: baseline,\n  fecha_medicion: fecha_medicion,\n  impacto_cop_estimado: prop.impacto_presupuesto_semanal != null ? prop.impacto_presupuesto_semanal : null\n};\n\nreturn [{ json: { decisiones_row: row, prop: prop } }];\n"
      }
    },
    {
      "id": "insert_decision",
      "name": "INSERT decisiones",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1780, 120],
      "parameters": {
        "method": "POST",
        "url": "https://vnctmzsgemefgbtjctlo.supabase.co/rest/v1/decisiones",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.decisiones_row) }}",
        "options": {}
      }
    },
    {
      "id": "stub_meta",
      "name": "STUB ejecucion Meta (NoOp)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2000, 120],
      "parameters": {}
    },
    {
      "id": "log_exec",
      "name": "INSERT ai_analysis_log (exec)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [2220, 120],
      "parameters": {
        "method": "POST",
        "url": "https://vnctmzsgemefgbtjctlo.supabase.co/rest/v1/ai_analysis_log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const p = $('Build decisiones row').item.json.prop; return JSON.stringify({ tipo: 'meta_action_executor', estado: 'ok', resumen: 'STUB ejecutado (sin Meta live). accion=' + p.accion + ' pct=' + p.pct + ' adset=' + p.adset_id + ' insight=' + p.insight_id + '. Fila decisiones creada con valor_baseline inmutable.' }); })() }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "GET propuestas meta aprobadas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET propuestas meta aprobadas": {
      "main": [
        [{ "node": "Filtra propuestas del agente", "type": "main", "index": 0 }]
      ]
    },
    "Filtra propuestas del agente": {
      "main": [[{ "node": "Por propuesta", "type": "main", "index": 0 }]]
    },
    "Por propuesta": {
      "main": [
        [],
        [{ "node": "GET decision existente?", "type": "main", "index": 0 }]
      ]
    },
    "GET decision existente?": {
      "main": [[{ "node": "Sin decision aun?", "type": "main", "index": 0 }]]
    },
    "Sin decision aun?": {
      "main": [
        [
          {
            "node": "GET roas_real baseline (adset)",
            "type": "main",
            "index": 0
          }
        ],
        [{ "node": "Por propuesta", "type": "main", "index": 0 }]
      ]
    },
    "GET roas_real baseline (adset)": {
      "main": [[{ "node": "Build decisiones row", "type": "main", "index": 0 }]]
    },
    "Build decisiones row": {
      "main": [[{ "node": "INSERT decisiones", "type": "main", "index": 0 }]]
    },
    "INSERT decisiones": {
      "main": [
        [{ "node": "STUB ejecucion Meta (NoOp)", "type": "main", "index": 0 }]
      ]
    },
    "STUB ejecucion Meta (NoOp)": {
      "main": [
        [
          {
            "node": "INSERT ai_analysis_log (exec)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "INSERT ai_analysis_log (exec)": {
      "main": [[{ "node": "Por propuesta", "type": "main", "index": 0 }]]
    }
  }
}
