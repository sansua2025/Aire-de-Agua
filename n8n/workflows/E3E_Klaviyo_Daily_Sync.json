      }
    },
    {
      "id": "580e5065-6459-40c3-a9b8-f9dd3d4b69a9",
      "name": "Get Flow Report Yesterday",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [480, 1000],
      "parameters": {
        "method": "POST",
        "url": "https://a.klaviyo.com/api/flow-values-reports",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.api+json" },
            { "name": "revision", "value": "2024-10-15" },
            { "name": "Content-Type", "value": "application/vnd.api+json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ data: { type: \"flow-values-report\", attributes: { statistics: [\"recipients\",\"delivered\",\"opens_unique\",\"clicks_unique\",\"conversions\",\"unsubscribes\",\"bounced\"], conversion_metric_id: \"ThumxF\", timeframe: { start: $(\"Set Config\").first().json.yesterdayStart, end: $(\"Set Config\").first().json.yesterdayEnd }, filter: \"equals(send_channel,\\\"email\\\")\" } } }) }}",
        "options": { "response": { "response": { "responseFormat": "json" } } }
      },
      "alwaysOutputData": true,
      "credentials": {
        "httpHeaderAuth": { "id": "PLACEHOLDER", "name": "Klaviyo AdeA" }
      }
    },
    {
      "id": "33d193d6-2b89-47c4-8bfd-3ba0e363fd70",
      "name": "Transform Flows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 1000],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const fecha = $(\"Set Config\").first().json.yesterdayISO;\nconst resp = $input.first() && $input.first().json;\nconst flows = (resp && resp.data && resp.data.attributes && Array.isArray(resp.data.attributes.flow_aggregation)) ? resp.data.attributes.flow_aggregation : [];\nconst rows = flows.map(f => {\n  const s = f.statistics || {};\n  const det = (f.flow_details && f.flow_details.attributes) || {};\n  return {\n    fecha,\n    klaviyo_flow_id: f.flow_id,\n    nombre: det.name || \"\",\n    estado: det.status || null,\n    trigger_type: det.triggerType || null,\n    enviados:     s.recipients       || 0,\n    entregados:   s.delivered        || 0,\n    abiertos:     s.opens_unique     || 0,\n    clics:        s.clicks_unique    || 0,\n    conversiones: s.conversions      || 0,\n    ingresos:     s.conversion_value || 0,\n    bajas:        s.unsubscribes     || 0\n  };\n});\nreturn [{ json: { rows } }];"
      }
    },
    {
      "id": "25a1fb96-6a08-43b2-99c4-44eafb7d2eb1",
      "name": "Upsert Flow Daily",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [960, 1000],
      "parameters": {
        "method": "POST",
        "url": "https://vnctmzsgemefgbtjctlo.supabase.co/rest/v1/klaviyo_flow_daily",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "on_conflict", "value": "fecha,klaviyo_flow_id" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.rows || []) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "PLACEHOLDER", "name": "Supabase AdeA" }
      }
    },
    {
      "id": "6e64f277-a6bf-4776-95c2-553ebdfa96fb",
