          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\"evento\":\"e3e_klaviyo_flows\",\"entidad\":\"klaviyo_flow_daily\",\"estado\":\"ok\"}",
