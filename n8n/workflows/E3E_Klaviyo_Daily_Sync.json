      }
    }
  ],
  "connections": {
    "Cron 8am COT": {
      "main": [[{ "node": "Set Config", "type": "main", "index": 0 }]]
    },
    "Set Config": {
      "main": [
        [
          { "node": "Get Sent Campaigns", "type": "main", "index": 0 },
          { "node": "Get Updated Profiles", "type": "main", "index": 0 },
          { "node": "Get Flow Report Yesterday", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get Sent Campaigns": {
      "main": [[{ "node": "Extract Campaigns", "type": "main", "index": 0 }]]
    },
    "Extract Campaigns": {
      "main": [[{ "node": "Loop Campaigns", "type": "main", "index": 0 }]]
    },
    "Loop Campaigns": {
      "main": [
        [{ "node": "Log Campaigns", "type": "main", "index": 0 }],
        [{ "node": "Get Campaign Report", "type": "main", "index": 0 }]
      ]
    },
    "Get Campaign Report": {
      "main": [[{ "node": "Transform Campaign", "type": "main", "index": 0 }]]
    },
    "Transform Campaign": {
      "main": [[{ "node": "Upsert Campaign", "type": "main", "index": 0 }]]
    },
    "Upsert Campaign": {
      "main": [[{ "node": "Loop Campaigns", "type": "main", "index": 0 }]]
    },
    "Get Updated Profiles": {
      "main": [[{ "node": "Transform Profiles", "type": "main", "index": 0 }]]
    },
    "Transform Profiles": {
      "main": [[{ "node": "Upsert Profiles", "type": "main", "index": 0 }]]
    },
    "Upsert Profiles": {
      "main": [[{ "node": "Log Profiles", "type": "main", "index": 0 }]]
    },
    "Get Flow Report Yesterday": {
      "main": [[{ "node": "Transform Flows", "type": "main", "index": 0 }]]
    },
    "Transform Flows": {
      "main": [[{ "node": "Upsert Flow Daily", "type": "main", "index": 0 }]]
    },
    "Upsert Flow Daily": {
      "main": [[{ "node": "Log Flows", "type": "main", "index": 0 }]]
    }
  },
  "tags": [],
  "meta": { "aiBuilderAssisted": true }
}
