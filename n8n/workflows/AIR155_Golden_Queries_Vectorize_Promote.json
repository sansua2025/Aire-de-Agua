    {
      "id": "ee93729f-a0da-403e-87b2-8feef9bad317",
      "name": "Construir Fila + Hash",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Una golden query validada por fila. Calcula pregunta_hash con la MISMA\n// normalizacion que la migracion 084 (lower + trim + colapsar espacios) y prepara\n// el texto para vectorizar (AIR-94: sin caracteres de control, acotado).\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const preguntaRaw = j.pregunta;\n  if (!preguntaRaw) continue;\n  const normalizada = String(preguntaRaw).trim().toLowerCase().replace(/\\s+/g, ' ');\n  const enc = new TextEncoder().encode(normalizada);\n  const buf = await crypto.subtle.digest('SHA-256', enc);\n  const pregunta_hash = Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');\n  const sanitize = (s) => s ? String(s).replace(/[\\x00-\\x1F\\x7F]/g, ' ').trim().substring(0, 2000) : '';\n  out.push({ json: {\n    texto: sanitize(preguntaRaw),\n    pregunta: String(preguntaRaw),\n    tool_call: j.tool_call,\n    resultado_validado: j.resultado_validado,\n    validado_por: j.validado_por || null,\n    pregunta_hash\n  } });\n}\nreturn out;"
      }
    },
