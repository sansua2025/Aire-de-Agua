        "jsCode": "const emb = $input.first().json.data[0].embedding;\nconst src = $('Construir Fila + Hash').first().json;\nreturn [{ json: { body: {\n  pregunta: src.pregunta,\n  tool_call: src.tool_call,\n  resultado_validado: src.resultado_validado,\n  embedding: emb,\n  modelo: 'text-embedding-3-small',\n  fuente: 'promocion_validada',\n  validado_por: src.validado_por,\n  activo: true,\n  pregunta_hash: src.pregunta_hash\n} } }];"
      }
    },
