    {
      "id": "7e2b9b06-e3e3-4de6-9c74-26ca0bd4734f",
      "name": "Preparar Textos Golden",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const records = $input.all().map(i => i.json).filter(r => r.id && r.pregunta);\nif (!records.length) return [];\n// AIR-94: quitar caracteres de control y acotar longitud antes de vectorizar.\nconst sanitize = (s) => s ? String(s).replace(/[\\x00-\\x1F\\x7F]/g, ' ').trim().substring(0, 2000) : '';\nconst texts = records.map(r => sanitize(r.pregunta));\nreturn [{ json: { texts, records } }];"
      }
    },
