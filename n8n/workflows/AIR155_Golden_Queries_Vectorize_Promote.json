        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const embs = $input.first().json.data.sort((a, b) => a.index - b.index);\nconst records = $('Preparar Textos Golden').first().json.records;\nreturn records.map((r, i) => ({ json: { id: r.id, embedding: embs[i].embedding } }));"
      }
