{
  "name": "E3A - Meta Ads Daily Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "e3a-0001-4aaa-b001-000000000001",
      "name": "Cron 7am COT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [220, 460]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "assign-yesterday",
              "name": "yesterday",
              "value": "={{ $now.minus(1, \"day\").toFormat(\"yyyy-MM-dd\") }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false
      },
      "id": "e3a-0001-4aaa-b001-000000000002",
      "name": "Set Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 460]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/act_{{ $credentials.metaAdAccountId }}/insights",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "time_range",
              "value": "={{ JSON.stringify({ since: $(\"Set Config\").first().json.yesterday, until: $(\"Set Config\").first().json.yesterday }) }}"
            },
            { "name": "level", "value": "ad" },
            {
              "name": "fields",
              "value": "ad_id,ad_name,adset_id,adset_name,campaign_id,campaign_name,objective,impressions,reach,clicks,inline_link_clicks,spend,actions,action_values"
            },
            { "name": "limit", "value": "500" },
            {
              "name": "filtering",
              "value": "[{\"field\":\"impressions\",\"operator\":\"GREATER_THAN\",\"value\":\"0\"}]"
            }
          ]
        },
        "options": {}
      },
      "id": "e3a-0001-4aaa-b001-000000000003",
      "name": "Fetch Meta Ads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 460],
      "credentials": {
        "httpHeaderAuth": {
          "id": "META_ADS_CREDENTIAL_ID",
          "name": "Meta Ads API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// DUPLICADO con E3A_Meta_Ads_Backfill.json — el bloque de mapeo debe mantenerse idéntico (guard: scripts/check-transform-ads-sync.sh). 'fecha' diverge a propósito.\n// Transform Meta Ads API response → format expected by upsert_meta_ads()\nconst yesterday = $(\"Set Config\").first().json.yesterday;\nconst response = $input.first().json;\nconst ads = response.data || [];\n\nif (ads.length === 0) {\n  return [{ json: { ads_data: [], count: 0 } }];\n}\n\nconst mapped = ads.map(ad => {\n  const actions = ad.actions || [];\n  const actionValues = ad.action_values || [];\n\n  const findAction = (type) => {\n    const found = actions.find(a => a.action_type === type);\n    return found ? parseInt(found.value) || 0 : 0;\n  };\n  const findActionValue = (type) => {\n    const found = actionValues.find(a => a.action_type === type);\n    return found ? parseFloat(found.value) || 0 : 0;\n  };\n\n  return {\n    fecha: yesterday,\n    ad_id: ad.ad_id,\n    ad_name: ad.ad_name,\n    adset_id: ad.adset_id,\n    adset_name: ad.adset_name,\n    campaign_id: ad.campaign_id,\n    campaign_name: ad.campaign_name,\n    creative_asset_id: null,\n    es_pagado: true,\n    objetivo: ad.objective || null,\n    audiencia: ad.adset_name || null,\n    impresiones: parseInt(ad.impressions) || 0,\n    alcance: parseInt(ad.reach) || 0,\n    clics: parseInt(ad.clicks) || 0,\n    clics_link: parseInt(ad.inline_link_clicks) || 0,\n    gasto: parseFloat(ad.spend) || 0,\n    compras: findAction('purchase'),\n    valor_compras: findActionValue('purchase'),\n    agrega_carrito: findAction('add_to_cart'),\n    inicia_checkout: findAction('initiate_checkout'),\n    vistas_contenido: findAction('view_content'),\n    headline: null,\n    body_copy: null,\n    cta: null,\n    meta_raw_json: ad\n  };\n});\n\nreturn [{ json: { ads_data: mapped, count: mapped.length } }];"
      },
      "id": "e3a-0001-4aaa-b001-000000000004",
      "name": "Transform Ads Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vnctmzsgemefgbtjctlo.supabase.co/rest/v1/rpc/upsert_meta_ads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ads_data: $json.ads_data }) }}",
        "options": {}
      },
      "id": "e3a-0001-4aaa-b001-000000000005",
      "name": "Upsert Meta Ads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1220, 460],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vnctmzsgemefgbtjctlo.supabase.co/rest/v1/sync_log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ evento: 'e3a_meta_ads_daily', entidad: 'meta_ads_performance', estado: 'ok' }) }}",
        "options": {}
      },
      "id": "e3a-0001-4aaa-b001-000000000006",
      "name": "Log Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1460, 460],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase API"
        }
      }
    }
  ],
  "connections": {
    "Cron 7am COT": {
      "main": [
        [
          { "node": "Set Config", "type": "main", "index": 0 }
        ]
      ]
    },
    "Set Config": {
      "main": [
        [
          { "node": "Fetch Meta Ads", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch Meta Ads": {
      "main": [
        [
          { "node": "Transform Ads Data", "type": "main", "index": 0 }
        ]
      ]
    },
    "Transform Ads Data": {
      "main": [
        [
          { "node": "Upsert Meta Ads", "type": "main", "index": 0 }
        ]
      ]
    },
    "Upsert Meta Ads": {
      "main": [
        [
          { "node": "Log Sync", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
