    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst orders = response.body?.orders || [];\nconst linkHeader = response.headers?.link || \"\";\nconst nextMatch = linkHeader.match(/<([^>]+)>;\\s*rel=\"next\"/);\nconst nextUrl = nextMatch ? nextMatch[1] : \"\";\n// La atribucion UTM se maneja desde E5A (shopify_customer_journeys), no aqui\nreturn [{ json: { orders_data: orders, count: orders.length, next_url: nextUrl, has_more: nextUrl !== \"\" } }];"
      },
