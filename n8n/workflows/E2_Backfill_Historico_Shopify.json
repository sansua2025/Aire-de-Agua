    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n// Validacion defensiva: un 429/5xx transitorio puede devolver body vacio o sin orders.\n// Si no llega un array body.orders, lanzamos error para detener RUIDOSAMENTE la paginacion\n// en vez de interpretar la respuesta corrupta como \"fin de paginas\".\nif (!response.body || !Array.isArray(response.body.orders)) {\n  throw new Error(`Respuesta de Shopify sin body.orders como array (posible 429/5xx). status=${response.statusCode ?? \"?\"}`);\n}\nconst orders = response.body.orders;\n// Recorte: con limit=100 cada pagina de ordenes de Shopify pesa varios MB; cada orden se reduce\n// al payload minimo que el RPC backfill_orders lee, para no reventar el limite de body de PostgREST.\nconst slim = orders.map(o => ({\n  id: o.id,\n  order_number: o.order_number,\n  source_name: o.source_name,\n  email: o.email,\n  note: o.note,\n  referring_site: o.referring_site,\n  landing_site: o.landing_site,\n  location_id: o.location_id,\n  created_at: o.created_at,\n  subtotal_price: o.subtotal_price,\n  total_discounts: o.total_discounts,\n  total_tax: o.total_tax,\n  total_price: o.total_price,\n  currency: o.currency,\n  payment_gateway: o.payment_gateway,\n  financial_status: o.financial_status,\n  fulfillment_status: o.fulfillment_status,\n  total_shipping_price_set: o.total_shipping_price_set\n    ? { shop_money: { amount: o.total_shipping_price_set?.shop_money?.amount ?? null } }\n    : null,\n  note_attributes: (o.note_attributes || []).map(na => ({ name: na.name, value: na.value })),\n  customer: o.customer\n    ? {\n        id: o.customer.id,\n        email: o.customer.email,\n        first_name: o.customer.first_name,\n        last_name: o.customer.last_name,\n        phone: o.customer.phone,\n        orders_count: o.customer.orders_count,\n        total_spent: o.customer.total_spent,\n        accepts_marketing: o.customer.accepts_marketing,\n        created_at: o.customer.created_at,\n        default_address: o.customer.default_address\n          ? {\n              city: o.customer.default_address.city,\n              province: o.customer.default_address.province,\n              country_code: o.customer.default_address.country_code\n            }\n          : null\n      }\n    : null,\n  line_items: (o.line_items || []).map(li => ({\n    id: li.id,\n    variant_id: li.variant_id,\n    title: li.title,\n    variant_title: li.variant_title,\n    sku: li.sku,\n    quantity: li.quantity,\n    price: li.price,\n    total_discount: li.total_discount\n  }))\n}));\nconst linkHeader = response.headers?.link || \"\";\nconst nextMatch = linkHeader.match(/<([^>]+)>;\\s*rel=\"next\"/);\nconst nextUrl = nextMatch ? nextMatch[1] : \"\";\n// La atribucion UTM se maneja desde E5A (shopify_customer_journeys), no aqui\nreturn [{ json: { orders_data: slim, count: slim.length, next_url: nextUrl, has_more: nextUrl !== \"\" } }];"
      },
