      "id": "b9522fb9-4b1f-4b8e-8af0-de555087cafa",
      "name": "Fetch All Products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        272,
        304
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "shopifyAccessTokenApi": {
          "id": "rrxe9HTxfm6k99Vw",
          "name": "Shopify Access Token account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// NOTA: 'Fetch All Products' usa limit=250 (max de Shopify) a proposito: es un fetch unico SIN\n// loop de paginacion, asi un limit menor descartaria silenciosamente productos >limit del catalogo.\n// El limit=100 del flujo de ORDENES es distinto: alli si hay paginacion + body PostgREST por lote.\nconst allItems = $input.all();\nconst sanitize = (str) => str ? str.replace(/[\\x00-\\x1F]/g, \"\").substring(0, 5000) : null;\nconst products = [];\nfor (const item of allItems) {\n  for (const p of (item.json.products || [])) {\n    products.push({\n      shopify_product_id: String(p.id), handle: p.handle,\n      titulo: sanitize(p.title), descripcion: sanitize(p.body_html),\n      tipo: sanitize(p.product_type) || null, tags: sanitize(p.tags),\n      estado: p.status, shopify_created_at: p.created_at, shopify_updated_at: p.updated_at,\n      variants: (p.variants || []).map(v => ({\n        shopify_variant_id: String(v.id),\n        shopify_inventory_item_id: v.inventory_item_id ? String(v.inventory_item_id) : null,\n        sku: v.sku || null, titulo: sanitize(v.title),\n        talla: v.option1 || null, color: v.option2 || null,\n        precio: String(parseFloat(v.price) || 0),\n        precio_comparacion: v.compare_at_price ? String(parseFloat(v.compare_at_price)) : null,\n        peso_gramos: v.grams ? String(v.grams) : null,\n        codigo_barras: v.barcode || null, shopify_updated_at: v.updated_at\n      }))\n    });\n  }\n}\nreturn [{ json: { products_data: products } }];"
      },
      "id": "00b40a46-d8e1-4122-8d71-77228a35e6ae",
      "name": "Prepare Products JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
