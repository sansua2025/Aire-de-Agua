    "Passthrough URL": { "main": [[{ "node": "Merge URLs", "type": "main", "index": 2 }]] },
    "Merge URLs": { "main": [[{ "node": "Loop One By One", "type": "main", "index": 0 }]] },
    "Loop One By One": { "main": [[{ "node": "Loop Done", "type": "main", "index": 0 }], [{ "node": "Download Image", "type": "main", "index": 0 }]] },
