    {
      "id": "ad757f98-654a-48f6-9c7d-8982aab95988",
      "name": "Resolve Image Hash",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        720,
        80
      ],
      "parameters": {
        "method": "GET",
        "url": "https://graph.facebook.com/v21.0/act_1055160342150593/adimages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "hashes",
              "value": "={{ JSON.stringify([$json.image_hash]) }}"
            },
            {
              "name": "fields",
