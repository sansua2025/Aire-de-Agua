      "id": "40bf807e-43b6-426e-9be3-57276015c1a7",
      "name": "RPC close_insight_loop",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [784, 208],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER",
          "name": "Supabase AdeA"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const closures = $input.all().map(function(i){return i.json;});\nconst total = closures.length;\nconst confirmados = closures.filter(function(c){return c.decision === 'confirmado';}).length;\nconst sin_cambio = closures.filter(function(c){return c.decision === 'sin_cambio';}).length;\nconst sin_datos = closures.filter(function(c){return c.decision === 'sin_datos';}).length;\nconst refutados = closures.filter(function(c){return c.decision === 'refutado';}).length;\nfunction fmtPct(n) { if (n == null) return '—'; const sign = n > 0 ? '+' : ''; return sign + Number(n).toFixed(1) + '%'; }\nconst subject = 'Aire de Agua · Loop Closer · ' + total + ' insights evaluados (' + confirmados + ' confirmados, ' + sin_cambio + ' sin cambio)';\nconst html = '<!doctype html><html><body><h2>Loop Closer · Aire de Agua</h2><p>' + total + ' evaluados · ' + confirmados + ' confirmados · ' + sin_cambio + ' sin cambio · ' + sin_datos + ' sin datos · ' + refutados + ' refutados</p></body></html>';\nreturn [{ json: { subject: subject, html: html, total_evaluados: total, confirmados: confirmados, sin_cambio: sin_cambio, sin_datos: sin_datos, refutados: refutados } }];"
      },
      "id": "275cb758-8ad6-4dae-a11f-3b8b5f3eb22b",
      "name": "Render Closure Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1008, 208]
    },
    {
      "parameters": {
        "sendTo": "marketing@airedeagua.com",
