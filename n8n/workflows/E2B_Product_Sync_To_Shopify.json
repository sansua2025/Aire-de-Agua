{
  "name": "E2B - Product Sync To Shopify",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "product-sync-to-shopify",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "e2b-0001-4aaa-b001-000000000001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 460],
      "webhookId": "product-sync-to-shopify"
    },
    {
      "parameters": {
        "jsCode": "// Map Supabase changed_fields → Shopify productUpdate mutation variables\nconst input = $input.first().json;\nconst shopifyProductId = input.shopify_product_id;\nconst changedFields = input.changed_fields;\n\n// Build ProductUpdateInput\nconst product = {\n  id: `gid://shopify/Product/${shopifyProductId}`\n};\nconst metafields = [];\n\n// Native fields\nif (changedFields.product_type !== undefined) {\n  product.productType = changedFields.product_type || '';\n}\nif (changedFields.tags !== undefined) {\n  // Supabase tags is text[], Shopify expects [String!]\n  product.tags = Array.isArray(changedFields.tags) ? changedFields.tags : [];\n}\n\n// Metafields (custom namespace)\nif (changedFields.material !== undefined) {\n  metafields.push({\n    namespace: 'custom',\n    key: 'material',\n    value: changedFields.material || '',\n    type: 'single_line_text_field'\n  });\n}\nif (changedFields.ocasion !== undefined) {\n  // ocasion is text[] in Supabase → list.single_line_text_field in Shopify\n  const val = Array.isArray(changedFields.ocasion)\n    ? JSON.stringify(changedFields.ocasion)\n    : '[]';\n  metafields.push({\n    namespace: 'custom',\n    key: 'ocasion',\n    value: val,\n    type: 'list.single_line_text_field'\n  });\n}\nif (changedFields.temporada !== undefined) {\n  metafields.push({\n    namespace: 'custom',\n    key: 'temporada',\n    value: changedFields.temporada || '',\n    type: 'single_line_text_field'\n  });\n}\nif (changedFields.genero !== undefined) {\n  metafields.push({\n    namespace: 'custom',\n    key: 'genero',\n    value: changedFields.genero || '',\n    type: 'single_line_text_field'\n  });\n}\n\nif (metafields.length > 0) {\n  product.metafields = metafields;\n}\n\nconst query = `mutation UpdateProduct($product: ProductUpdateInput!) {\n  productUpdate(product: $product) {\n    product { id productType tags }\n    userErrors { field message }\n  }\n}`;\n\nreturn [{\n  json: {\n    producto_id: input.producto_id,\n    shopify_product_id: shopifyProductId,\n    query,\n    variables: { product }\n  }\n}];"
      },
      "id": "e2b-0001-4aaa-b001-000000000002",
      "name": "Map to Shopify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $credentials.shopifyDomain }}/admin/api/2024-10/graphql.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: $json.query, variables: $json.variables }) }}",
        "options": {}
      },
      "id": "e2b-0001-4aaa-b001-000000000003",
      "name": "Update Shopify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 460],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SHOPIFY_CREDENTIAL_ID",
          "name": "Shopify Admin API"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://vnctmzsgemefgbtjctlo.supabase.co/rest/v1/productos?id=eq.{{ $json.producto_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ last_synced_at: new Date().toISOString() }) }}",
        "options": {}
      },
      "id": "e2b-0001-4aaa-b001-000000000004",
      "name": "Update last_synced_at",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 460],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vnctmzsgemefgbtjctlo.supabase.co/rest/v1/sync_log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"evento\":\"product_sync_to_shopify\",\"entidad\":\"productos\",\"estado\":\"ok\"}",
        "options": {}
      },
      "id": "e2b-0001-4aaa-b001-000000000005",
      "name": "Log Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 460],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'ok', shopify_product_id: $(\"Map to Shopify\").first().json.shopify_product_id }) }}",
        "options": {}
      },
      "id": "e2b-0001-4aaa-b001-000000000006",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1420, 460]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          { "node": "Map to Shopify", "type": "main", "index": 0 }
        ]
      ]
    },
    "Map to Shopify": {
