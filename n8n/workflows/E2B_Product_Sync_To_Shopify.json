    {
      "id": "11beffaf-a175-41f3-a1a9-4fdb934c3131",
      "name": "Map to Shopify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $input.first().json;\nconst changed = cfg.changed_fields || {};\nconst productInput = { id: \"gid://shopify/Product/\" + cfg.shopify_product_id };\nif (changed.product_type !== undefined && changed.product_type !== null) {\n  productInput.productType = String(changed.product_type);\n}\nif (changed.tags !== undefined) {\n  if (Array.isArray(changed.tags)) productInput.tags = changed.tags;\n  else if (changed.tags === null) productInput.tags = [];\n  else productInput.tags = [String(changed.tags)];\n}\nconst query = \"mutation productUpdate($input: ProductInput!) {\\n\"\n  + \"  productUpdate(input: $input) {\\n\"\n  + \"    product { id productType tags }\\n\"\n  + \"    userErrors { field message }\\n\"\n  + \"  }\\n\"\n  + \"}\";\nreturn [{ json: {\n  producto_id: cfg.producto_id,\n  shopify_product_id: cfg.shopify_product_id,\n  dryRun: cfg.dryRun === true || cfg.dryRun === \"true\",\n  query,\n  variables: { input: productInput }\n} }];"
      }
    },
    {
      "id": "23b55b8a-d98d-42c8-8cc2-116a26d0e308",
