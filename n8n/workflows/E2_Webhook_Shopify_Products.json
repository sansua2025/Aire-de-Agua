    {
      "parameters": {
        "jsCode": "const p = $input.first().json;\nconst sanitize = (str) => str ? str.replace(/[\\x00-\\x1F]/g, \"\").substring(0, 5000) : null;\nconst product = {\n  shopify_product_id: String(p.id), handle: p.handle,\n  titulo: sanitize(p.title), descripcion: sanitize(p.body_html),\n  tipo: sanitize(p.product_type) || null, tags: sanitize(p.tags),\n  estado: p.status, shopify_created_at: p.created_at, shopify_updated_at: p.updated_at,\n  variants: (p.variants || []).map(v => ({\n    shopify_variant_id: String(v.id),\n    shopify_inventory_item_id: v.inventory_item_id ? String(v.inventory_item_id) : null,\n    sku: v.sku || null, titulo: sanitize(v.title),\n    talla: v.option1 || null, color: v.option2 || null,\n    precio: String(parseFloat(v.price) || 0),\n    precio_comparacion: v.compare_at_price ? String(parseFloat(v.compare_at_price)) : null,\n    peso_gramos: v.grams ? String(v.grams) : null,\n    codigo_barras: v.barcode || null, shopify_updated_at: v.updated_at\n  }))\n};\nreturn [{ json: { products_data: [product] } }];"
      },
      "id": "bd4ba07a-1f7e-46d1-bc44-98e780e8f0a6",
      "name": "Sanitize Product Data",
      "type": "n8n-nodes-base.code",
