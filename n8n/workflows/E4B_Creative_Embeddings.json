        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const embs = $input.first().json.data.sort((a, b) => a.index - b.index);\nconst d = $(\"Preparar Textos Creativos\").first().json;\nreturn d.ads.map((a, i) => ({ json: {\n  ad_id: a.ad_id,\n  ad_name: a.ad_name || null,\n  campaign_name: a.campaign_name || null,\n  texto_fuente: d.texts[i],\n  embedding: embs[i].embedding,\n  modelo: \"text-embedding-3-small\",\n  objetivo: a.objetivo || null,\n  audiencia: a.audiencia || null,\n  cta: a.cta || null\n} }));"
      }
