    {
      "id": "9d8189c8-5e31-4255-9669-2fc9b368bb77",
      "name": "Preparar Textos Creativos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        304
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ads = $input.all().map(i => i.json).filter(a => a.ad_id);\nif (!ads.length) return [];\nconst sanitize = (s) => s ? String(s).replace(/[\\x00-\\x1F]/g, \" \").substring(0, 3000) : \"\";\nconst joinArr = (arr) => Array.isArray(arr) && arr.length ? arr.filter(Boolean).join(\" / \") : \"\";\nconst texts = ads.map(a => {\n  const parts = [];\n  if (a.ad_name) parts.push(sanitize(a.ad_name));\n  if (a.adset_name) parts.push(\"Adset: \" + sanitize(a.adset_name));\n  if (a.campaign_name) parts.push(\"Campaign: \" + sanitize(a.campaign_name));\n  if (a.objetivo) parts.push(\"Objetivo: \" + a.objetivo);\n  if (a.optimization_goal) parts.push(\"Optim: \" + a.optimization_goal);\n  if (a.headline) parts.push(\"Headline: \" + sanitize(a.headline));\n  if (a.body_copy) parts.push(\"Body: \" + sanitize(a.body_copy));\n  if (a.link_description) parts.push(\"Description: \" + sanitize(a.link_description));\n  if (a.cta) parts.push(\"CTA: \" + a.cta);\n  const titlesText = joinArr(a.asset_feed_titles);\n  if (titlesText) parts.push(\"Titles: \" + sanitize(titlesText));\n  const bodiesText = joinArr(a.asset_feed_bodies);\n  if (bodiesText) parts.push(\"Bodies: \" + sanitize(bodiesText));\n  const descsText = joinArr(a.asset_feed_descriptions);\n  if (descsText) parts.push(\"Descriptions: \" + sanitize(descsText));\n  if (a.targeting_summary) parts.push(\"Audiencia: \" + sanitize(a.targeting_summary));\n  if (a.visual_description) parts.push(\"Visual: \" + sanitize(a.visual_description));\n  return parts.join(\" | \");\n});\nreturn [{ json: { texts, ads } }];"
      }
    },
