{
  "id": "E6RfmDailyRecalc01",
  "name": "E6 - RFM Daily Recalc",
  "active": false,
  "description": "E6 · AIR-41. Cron diario 2am COT (0 7 * * * UTC). RPC recalcular_rfm_clientes() recalcula la segmentación RFM de clientes (UPDATE A: segmento/ltv/canal; UPDATE B: tallas/colores). Loguea en ai_analysis_log (tipo=segment_update) con segmentos_actualizados=total_actualizados y resumen='nuevo=<n>'. Luego revisa los últimos 7 runs: si TODOS tienen nuevo=0, alerta a Slack (degrada a no-op si no hay SLACK_WEBHOOK_URL) — señal de posible falla del pipeline de ventas.",
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "ErrorHandlerGlobal01"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "e6-cron-0001",
      "name": "Cron Daily 2am COT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [128, 368]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vnctmzsgemefgbtjctlo.supabase.co/rest/v1/rpc/recalcular_rfm_clientes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {}
      },
      "id": "e6-rpc-recalc-0001",
      "name": "RPC recalcular_rfm_clientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [352, 368],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER",
          "name": "Supabase AdeA"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vnctmzsgemefgbtjctlo.supabase.co/rest/v1/ai_analysis_log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const r = $json || {}; const nuevo = (r.nuevo_count != null) ? r.nuevo_count : 0; const total = (r.total_actualizados != null) ? r.total_actualizados : 0; return JSON.stringify({ tipo: \"segment_update\", estado: \"ok\", segmentos_actualizados: total, resumen: \"nuevo=\" + nuevo + \" | vip=\" + ((r.vip_count != null) ? r.vip_count : 0) + \" | recurrente=\" + ((r.recurrente_count != null) ? r.recurrente_count : 0) + \" | perdido=\" + ((r.perdido_count != null) ? r.perdido_count : 0) + \" | dormido=\" + ((r.dormido_count != null) ? r.dormido_count : 0) }); })() }}",
        "options": {}
      },
      "id": "e6-insert-log-0001",
      "name": "INSERT log (segment_update)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [576, 368],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER",
          "name": "Supabase AdeA"
        }
      }
    },
    {
      "parameters": {
        "url": "https://vnctmzsgemefgbtjctlo.supabase.co/rest/v1/ai_analysis_log?tipo=eq.segment_update&select=resumen,created_at&order=created_at.desc&limit=7",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "e6-get-last7-0001",
      "name": "GET last 7 runs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [800, 368],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER",
          "name": "Supabase AdeA"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// AIR-41 · Evalúa si 'nuevo'=0 en los últimos 7 runs consecutivos.\n// La RPC devuelve filas; cada item es un run de ai_analysis_log (resumen='nuevo=<n> | ...').\nconst runs = $input.all().map(function (i) { return i.json; });\n\n// Parsea 'nuevo=<n>' del campo resumen.\nfunction parseNuevo(resumen) {\n  if (resumen == null) return null;\n  const m = String(resumen).match(/nuevo\\s*=\\s*(\\d+)/i);\n  return m ? parseInt(m[1], 10) : null;\n}\n\nconst nuevos = runs.map(function (r) { return parseNuevo(r.resumen); });\nconst total = nuevos.length;\n\n// Solo alerta si hay >=7 runs y TODOS tienen nuevo=0 (parseable).\nconst sieteOMas = total >= 7;\nconst todosCero = sieteOMas && nuevos.every(function (n) { return n === 0; });\n\n// Slack URL desde env (puede estar vacía -> no se notifica).\nlet slackUrl = '';\ntry { slackUrl = ($env && $env.SLACK_WEBHOOK_URL) ? String($env.SLACK_WEBHOOK_URL).trim() : ''; } catch (e) { slackUrl = ''; }\nconst hasSlack = /^https?:\\/\\//i.test(slackUrl);\n\nconst slackText = '⚠️ RFM: segmento \\'nuevo\\'=0 por 7 días consecutivos — posible falla del pipeline de ventas';\n\nreturn [{ json: {\n  runs_evaluados: total,\n  todos_cero: todosCero,\n  debe_alertar: todosCero && hasSlack,\n  slack_url: slackUrl,\n  has_slack: hasSlack,\n  slack_text: slackText\n} }];"
      },
      "id": "e6-eval-7days-0001",
      "name": "Evaluate 7-day streak",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1024, 368]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-debe-alertar",
              "leftValue": "={{ $json.debe_alertar }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "e6-if-alert-0001",
      "name": "Alert needed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1248, 368]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.slack_url }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.slack_text }) }}",
        "options": {}
      },
      "id": "e6-notify-slack-0001",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1472, 256],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Cron Daily 2am COT": {
      "main": [
        [{ "node": "RPC recalcular_rfm_clientes", "type": "main", "index": 0 }]
      ]
    },
