    {
      "parameters": {
        "jsCode": "const products = $input.all().map(i => i.json).filter(p => p.id);\nif (!products.length) return [];\nconst sanitize = (s) => s ? s.replace(/[\\x00-\\x1F]/g, '').substring(0, 3000) : '';\nconst texts = products.map(p => {\n  const parts = [sanitize(p.titulo)];\n  if (p.tipo) parts.push('- ' + p.tipo);\n  if (p.coleccion) parts.push('de ' + p.coleccion);\n  if (p.descripcion) parts.push('. ' + sanitize(p.descripcion));\n  if (p.material) parts.push('. Material: ' + sanitize(p.material));\n  if (p.ocasion) parts.push('. Ocasion: ' + (Array.isArray(p.ocasion) ? p.ocasion.join(', ') : p.ocasion));\n  if (p.temporada) parts.push('. Temporada: ' + p.temporada);\n  return parts.join(' ');\n});\nreturn [{ json: { texts, products } }];"
      },
