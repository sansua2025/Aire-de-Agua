# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shopify
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Meta Ads
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_SECRET=

# Amplitude
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=

# Klaviyo
KLAVIYO_PRIVATE_API_KEY=

# OpenAI (embeddings)
OPENAI_API_KEY=

# Anthropic (Claude analysis)
ANTHROPIC_API_KEY=

# n8n REST API (Settings > API > Create API Key)
N8N_API_URL=https://tu-instancia.app.n8n.cloud/api/v1
N8N_API_KEY=

# n8n MCP server — token del panel "MCP Server" en n8n Cloud (donde sale la URL
# /mcp-server/http). NO es N8N_API_KEY (esa da 401 contra el MCP). Lo consume
# .mcp.json como `Authorization: Bearer ${N8N_MCP_TOKEN}`.
# En local: ponlo en .env y `source .env`. En Claude Code web: cargalo como
# secret/env var del entorno, no en un archivo.
N8N_MCP_TOKEN=

# Slack
SLACK_WEBHOOK_URL=
